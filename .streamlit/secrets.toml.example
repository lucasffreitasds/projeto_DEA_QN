# Modelo do arquivo de usuários do painel.
#
# 1. Copie este arquivo para .streamlit/secrets.toml (o .gitignore impede que ele vá para o GitHub).
# 2. Para cada pessoa, rode na pasta do projeto:   python auth.py
#    e cole o bloco que ele imprimir abaixo (apagando os exemplos).
# 3. No Streamlit Community Cloud, cole o mesmo conteúdo em: App settings -> Secrets.
#
# Perfis:
#   tecnico -> vê o painel e pode atualizar/publicar a planilha
#   leitor  -> só vê o painel
#
# As senhas NUNCA ficam em texto puro: só o hash gerado pelo auth.py.

[usuarios.exemplo_tecnico]
senha_hash = "cole-aqui-o-hash-gerado-pelo-auth.py"
perfil = "tecnico"

[usuarios.exemplo_leitor]
senha_hash = "cole-aqui-o-hash-gerado-pelo-auth.py"
perfil = "leitor"
